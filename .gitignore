zkproof/keys/*
!zkproof/keys/.gitkeep
zkproof/proofs/*
!zkproof/proofs/.gitkeep
zkproof/tmp/
zkproof/kzg.srs
zkproof/compiled.ezkl
zkproof/sample_input.json
